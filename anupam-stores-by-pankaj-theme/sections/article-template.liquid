{% if comment and comment.created_at %}{% assign number_of_comments = article.comments_count | plus: 1 %}{% else %}{% assign number_of_comments = article.comments_count %}{% endif %}
<article class="blog-article" data-section-id="{{ section.id }}" data-section-type="article-template" itemscope itemtype="http://schema.org/Article" aria-labelledby="article-title">
  <div class="container">
    <div class="blog-top">
      <nav class="collection-crumb blog-crumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <a href="{{ blog.url }}">{{ blog.title | default: 'Blogs' }}</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <span aria-current="page">{{ article.title }}</span>
      </nav>
      <div class="blog-page-title">{{ blog.title | default: 'Blogs' }}</div>
    </div>

    {% if article.image %}
    <div class="article-hero">
      <img src="{{ article.image | img_url: '1200x' }}" alt="{{ article.title | escape }}" width="1200" height="675">
    </div>
    {% endif %}

    <header class="article-header">
      <h1 class="article-title" id="article-title" itemprop="headline">{{ article.title }}</h1>
      <p class="article-meta">
        <span>
          <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
          <span itemprop="dateCreated pubdate datePublished">{{ article.published_at | date: '%d %b, %Y' }}</span>
        </span>
        {% if article.author != blank %}
        <span class="blog-meta-sep" aria-hidden="true">|</span>
        <span>
          <span class="material-symbols-outlined" aria-hidden="true">person</span>
          By: <span itemprop="author">{{ article.author }}</span>
        </span>
        {% endif %}
        {% if article.tags.size > 0 %}
        <span class="blog-meta-sep" aria-hidden="true">|</span>
        <span>
          <span class="material-symbols-outlined" aria-hidden="true">article</span>
          {% for tag in article.tags limit: 3 %}<a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}
        </span>
        {% endif %}
        {% if article.comments_enabled? %}
        <span class="blog-meta-sep" aria-hidden="true">|</span>
        <span>
          <span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span>
          {{ article.comments_count }} {{ 'blogs.comments.comments' | t }}
        </span>
        {% endif %}
      </p>
    </header>

    <div class="article-body article-content rte" itemprop="articleBody">{{ article.content }}</div>

    {% if section.settings.social_sharing %}
    {% if settings.share_linkedin or settings.share_facebook or settings.share_twitter or settings.share_pinterest %}
    <div class="article-share tt-social-share">
      <p class="article-share-title">{{ "blogs.article.share_post" | t }}</p>
      {% if settings.share_facebook %}
      <a class="facebook" target="_blank" rel="noopener" href="http://www.facebook.com/sharer.php?u={{ shop.url }}{{ article.url }}" aria-label="Share on Facebook"><i class="mdi mdi-facebook"></i></a>
      {% endif %}
      {% if settings.share_twitter %}
      <a class="twitter" target="_blank" rel="noopener" href="http://twitter.com/share?url={{ shop.url }}{{ article.url }}" aria-label="Share on Twitter">
        <svg class="icon icon-twitter" viewBox="0 0 20 20" style="width:14px;height:auto;display:inline-block;">
          <path fill="currentColor" fill-rule="evenodd" d="M7.273 2.8 10.8 7.822 15.218 2.8h1.768l-5.4 6.139 5.799 8.254h-4.658l-3.73-5.31-4.671 5.31H2.558l5.654-6.427L2.615 2.8zm6.242 13.125L5.07 4.109h1.405l8.446 11.816z" clip-rule="evenodd"></path>
        </svg>
      </a>
      {% endif %}
      {% if settings.share_pinterest %}
      <a class="pinterest" target="_blank" rel="noopener" href="http://pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url }}" aria-label="Share on Pinterest"><i class="mdi mdi-pinterest"></i></a>
      {% endif %}
      {% if settings.share_linkedin %}
      <a class="linkedin" target="_blank" rel="noopener" href="http://www.linkedin.com/shareArticle?mini=true&url={{ shop.url }}{{ article.url }}" aria-label="Share on LinkedIn"><i class="mdi mdi-linkedin"></i></a>
      {% endif %}
    </div>
    {% endif %}
    {% endif %}

    {% if blog.next_article or blog.previous_article %}
    <nav class="article-nav paginatoin_custom blog_nav" aria-label="More articles">
      {% if blog.previous_article %}
      <a href="{{ blog.previous_article.url }}">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        {{ blog.previous_article.title }}
      </a>
      {% endif %}
      {% if blog.next_article %}
      <a href="{{ blog.next_article.url }}">
        {{ blog.next_article.title }}
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
      {% endif %}
    </nav>
    {% endif %}

    {% if blog.comments_enabled? %}
    <div class="article-comments comments" id="comments">
      {% paginate article.comments by 5 %}
      {% if number_of_comments > 0 %}
      <h2 class="article-comments-title">{{ 'blogs.comments.with_count' | t: count: number_of_comments }}</h2>
      <ul>
        {% if comment and comment.created_at %}
        <li id="{{ comment.id }}" class="comment first{% if article.comments_count == 0 %} last{% endif %}">
          {% render 'comment', comment: comment %}
        </li>
        {% endif %}
        {% for comment in article.comments %}
        <li id="{{ comment.id }}" class="comment{% unless number_of_comments > article.comments_count %}{% if forloop.first %} first{% endif %}{% endunless %}{% if forloop.last %} last{% endif %}">
          {% render 'comment', comment: comment %}
        </li>
        {% endfor %}
      </ul>
      {% if paginate.pages > 1 %}
      <div class="text-center">
        {% render 'pagination-custom' %}
      </div>
      {% endif %}
      {% endif %}

      {% if comment and comment.created_at %}
      <p class="note form-success">
        {% if blog.moderated? %}
        {{ 'blogs.comments.success_moderated' | t }}
        {% else %}
        {{ 'blogs.comments.success' | t }}
        {% endif %}
      </p>
      {% endif %}

      {% form 'new_comment', article %}
      {{ form.errors | default_errors }}
      <div class="grid--full">
        <h2 class="article-comments-title">{{ 'blogs.comments.title' | t }}</h2>
        <div class="grid-item comments-form__author">
          <label for="comment-author" class="form-label--hidden">
            <span class="visuallyhidden">{{ 'blogs.comments.name' | t }}</span>
          </label>
          <input {% if form.errors contains "author" %}class="error"{% endif %} type="text" name="comment[author]" placeholder="{{ 'blogs.comments.name' | t }}" id="comment-author" value="{{ form.author }}" autocapitalize="words">
        </div>
        <div class="grid-item comments-form__email">
          <label for="comment-email" class="form-label--hidden">
            <span class="visuallyhidden">{{ 'blogs.comments.email' | t }}</span>
          </label>
          <input {% if form.errors contains "email" %}class="error"{% endif %} type="email" name="comment[email]" placeholder="{{ 'blogs.comments.email' | t }}" id="comment-email" value="{{ form.email }}" autocorrect="off" autocapitalize="off">
        </div>
        <div class="grid-item">
          <label for="comment-body" class="form-label--hidden">
            <span class="visuallyhidden">{{ 'blogs.comments.message' | t }}</span>
          </label>
          <textarea {% if form.errors contains "body" %}class="error"{% endif %} name="comment[body]" id="comment-body" placeholder="{{ 'blogs.comments.message' | t }}">{{ form.body }}</textarea>
        </div>
        <div class="grid-item">
          {% if blog.moderated? %}
          <p class="desc">{{ 'blogs.comments.moderated' | t }}</p>
          {% endif %}
          <input type="submit" class="btn text-center" value="{{ 'blogs.comments.post' | t }}">
        </div>
      </div>
      {% endform %}
      {% endpaginate %}
    </div>
    {% endif %}
  </div>
</article>

{%- assign recent_articles = blogs[blog.handle].articles -%}
{% if recent_articles.size > 1 %}
<section class="section blog-recent" id="recent-articles" aria-labelledby="recent-articles-title" data-slider>
  <div class="container">
    <div class="section-head">
      <h2 class="section-title" id="recent-articles-title">Recent Articles</h2>
      <div class="section-controls">
        <button class="slider-btn prev" type="button" data-slider-prev aria-label="Previous recent articles">
          <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
        </button>
        <button class="slider-btn next" type="button" data-slider-next aria-label="Next recent articles">
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </button>
      </div>
    </div>
    <div class="slider-wrapper">
      <div class="slider-track blog-recent-track" data-slider-track>
        {% assign recent_shown = 0 %}
        {% for recent in recent_articles limit: 9 %}
          {% if recent.id == article.id %}{% continue %}{% endif %}
          {% if recent_shown >= 8 %}{% break %}{% endif %}
          {% assign recent_shown = recent_shown | plus: 1 %}
          <article class="blog-card blog-card--vertical" data-slider-item>
            <a class="blog-card-image" href="{{ recent.url }}">
              {% if recent.image %}
              <img src="{{ recent.image | img_url: '800x500', crop: 'center' }}" alt="{{ recent.title | escape }}" width="800" height="500" loading="lazy">
              {% else %}
              <img src="{{ 'no-image.gif' | img_url: 'master' }}" alt="{{ recent.title | escape }}" width="800" height="500" loading="lazy">
              {% endif %}
            </a>
            <div class="blog-card-body">
              <h3 class="blog-card-title"><a href="{{ recent.url }}">{{ recent.title }}</a></h3>
              <p class="blog-card-meta">
                <span>
                  <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                  {{ recent.published_at | date: '%d %b, %Y' }}
                </span>
                {% if recent.author != blank %}
                <span class="blog-meta-sep" aria-hidden="true">|</span>
                <span>
                  <span class="material-symbols-outlined" aria-hidden="true">person</span>
                  By: {{ recent.author }}
                </span>
                {% endif %}
              </p>
              <p class="blog-excerpt">
                {%- if recent.excerpt != blank -%}
                {{ recent.excerpt | strip_html | truncate: 140 }}
                {%- else -%}
                {{ recent.content | strip_html | truncate: 140 }}
                {%- endif -%}
              </p>
              <a class="blog-read-more" href="{{ recent.url }}">
                {{ 'blogs.article.read_more' | t }}
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<script type="application/ld+json">
   "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }}
</script>
{% schema %}
{
"name": "Article",
"class": "article-template",
  "disabled_on": {
    "groups": ["header","footer"]
},
"settings": [
{
"type": "checkbox",
"id": "social_sharing",
"label": "Enable blog post sharing"
},{
"type": "checkbox",
"id": "enable_left_sidebar",
"label": "Enable blog Left sidebar"
}
]
}
{% endschema %}
