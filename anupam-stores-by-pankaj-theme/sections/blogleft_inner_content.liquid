{%- assign articles_per_page = section.settings.blogpage_article_limit | default: 6 -%}
{% paginate blog.articles by articles_per_page %}
<section class="blog-listing" aria-labelledby="blog-listing-title">
  <div class="container">
    <div class="blog-top">
      <nav class="collection-crumb blog-crumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <span aria-current="page">{{ blog.title | default: 'Blogs' }}</span>
      </nav>
      <h1 class="blog-page-title" id="blog-listing-title">{{ blog.title | default: 'Blogs' }}</h1>
    </div>

    <div class="blog-list">
      {% for article in blog.articles %}
      {%- assign image_right = false -%}
      {%- assign position = forloop.index0 | modulo: 2 -%}
      {%- if position == 1 -%}{%- assign image_right = true -%}{%- endif -%}
      <article class="blog-card{% if image_right %} blog-card--image-right{% else %} blog-card--image-left{% endif %}">
        {% if section.settings.show_blog_4_img %}
        <a class="blog-card-image" href="{{ article.url }}">
          {% if article.image %}
          <img src="{{ article.image | img_url: '800x500', crop: 'center' }}" alt="{{ article.title | escape }}" width="800" height="500"{% unless forloop.first %} loading="lazy"{% endunless %}>
          {% else %}
          <img src="{{ 'no-image.gif' | img_url: 'master' }}" alt="{{ article.title | escape }}" width="800" height="500" loading="lazy">
          {% endif %}
        </a>
        {% endif %}
        <div class="blog-card-body">
          <h2 class="blog-card-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p class="blog-card-meta">
            {% if section.settings.show_blog_4_date %}
            <span>
              <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
              {{ article.published_at | date: '%d %b, %Y' }}
            </span>
            <span class="blog-meta-sep" aria-hidden="true">|</span>
            {% endif %}
            {% if article.author != blank %}
            <span>
              <span class="material-symbols-outlined" aria-hidden="true">person</span>
              By: {{ article.author }}
            </span>
            {% endif %}
            {% if article.tags.size > 0 and section.settings.show_blog_4_tag %}
            <span class="blog-meta-sep" aria-hidden="true">|</span>
            <span>
              <span class="material-symbols-outlined" aria-hidden="true">article</span>
              {% for tag in article.tags limit: 2 %}<a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}
            </span>
            {% endif %}
            {% if article.comments_enabled? %}
            <span class="blog-meta-sep" aria-hidden="true">|</span>
            <span>
              <span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span>
              {{ article.comments_count }} {{ 'blogs.comments.comments' | t }}
            </span>
            {% endif %}
          </p>
          {% if section.settings.show_blog_4_content %}
          <p class="blog-excerpt">
            {%- if article.excerpt != blank -%}
            {{ article.excerpt | strip_html | truncate: 320 }}
            {%- else -%}
            {{ article.content | strip_html | truncate: 320 }}
            {%- endif -%}
          </p>
          {% endif %}
          {% if section.settings.show_blog_4_btn %}
          <a class="blog-read-more" href="{{ article.url }}">
            {{ 'blogs.article.read_more' | t }}
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
          {% endif %}
        </div>
      </article>
      {% else %}
      <p class="blog-excerpt">No articles have been published yet.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
    <nav class="collection-pagination blog-pagination" aria-label="Blog pagination">
      {% if paginate.previous %}
      <a class="page-btn" href="{{ paginate.previous.url }}">Previous</a>
      {% else %}
      <button class="page-btn" type="button" disabled>Previous</button>
      {% endif %}
      {% for part in paginate.parts %}
        {% if part.is_link %}
        <a class="page-btn" href="{{ part.url }}">{{ part.title }}</a>
        {% elsif part.title == paginate.current_page %}
        <span class="page-btn is-active" aria-current="page">{{ part.title }}</span>
        {% else %}
        <span class="page-btn">{{ part.title }}</span>
        {% endif %}
      {% endfor %}
      {% if paginate.next %}
      <a class="page-btn" href="{{ paginate.next.url }}">Next</a>
      {% else %}
      <button class="page-btn" type="button" disabled>Next</button>
      {% endif %}
    </nav>
    {% endif %}
  </div>
</section>
{% endpaginate %}
{% schema %}
{
"name": "Blog Page Inner Section",
"class": "blogleft_inner_content",
"settings": [
{
"type": "checkbox",
"id": "show_blog_4_content",
"label": "Display Blog content"
},
{
"type": "checkbox",
"id": "show_blog_4_img",
"label": "Display Blog img"
},
{
"type": "checkbox",
"id": "show_blog_4_btn",
"label": "Display Blog button"
},
{
"type": "checkbox",
"id": "show_blog_4_date",
"label": "Display Blog date"
},
{
"type": "checkbox",
"id": "show_blog_4_tag",
"label": "Display Blog tag"
},
{
"type": "checkbox",
"id": "show_blog_masonry",
"label": "Display Blog Masonry Effect"
},
{
"type": "checkbox",
"id": "show_facebook_share",
"label": "Display Facebook share Icon"
},
{
"type": "checkbox",
"id": "show_twitter_share",
"label": "Display Twitter share Icon"
},
{
"type": "checkbox",
"id": "show_pinterest_share",
"label": "Display Pinterest share Icon"
},
{
"type": "checkbox",
"id": "show_linkedin_share",
"label": "Display LinkedIn share Icon"
},
{
"type": "select",
"id": "blog_column",
"label": "Select Blog Column",
"options": [
{
"value": "col_2",
"label": "Column 2"
},
{
"value": "col_3",
"label": "Column 3"
},
{
"value": "col_4",
"label": "Column 4"
}
]
},
{
"type": "number",
"id": "blogpage_article_limit",
"label": "Blog Page Article limit",
"default": 6
},

{
"type": "color",
"id": "blog_btn_text",
"label": "Blog Button Text",
"default": "#fff"
},
{
"type": "color",
"id": "blog_btn_hover_bg",
"label": "Blog Hover Button",
"default": "#DA983D"
},
{
"type": "color",
"id": "blog_hover_btn_text",
"label": "Blog Hover Button Text",
"default": "#fff"
}
]
}
{% endschema %}
