<section class="promo-banner" data-slider aria-label="Collection promotions">
  <div class="slider-track promo-track" data-slider-track>
    {% if section.settings.banner1_img != blank %}
    <a class="promo-slide" data-slider-item href="{% if section.settings.banner1_url != blank %}{{ section.settings.banner1_url }}{% else %}#{% endif %}">
      <img class="promo-slide-img" loading="lazy" src="{{ section.settings.banner1_img | img_url: 'master' }}" alt="{{ section.settings.banner1_title | default: 'Promotion' | escape }}">
      {% if section.settings.banner1_title != blank or section.settings.banner1_desc != blank or section.settings.banner1_subtitle != blank %}
      <div class="promo-copy">
        {% if section.settings.banner1_subtitle != blank %}<p>{{ section.settings.banner1_subtitle }}</p>{% endif %}
        {% if section.settings.banner1_title != blank %}<h3 class="promo-title">{{ section.settings.banner1_title }}</h3>{% endif %}
        {% if section.settings.banner1_desc != blank %}<p>{{ section.settings.banner1_desc }}</p>{% endif %}
      </div>
      {% endif %}
    </a>
    {% endif %}
    {% if section.settings.banner2_img != blank %}
    <a class="promo-slide" data-slider-item href="{% if section.settings.banner2_url != blank %}{{ section.settings.banner2_url }}{% else %}#{% endif %}">
      <img class="promo-slide-img" loading="lazy" src="{{ section.settings.banner2_img | img_url: 'master' }}" alt="{{ section.settings.banner2_title | default: 'Promotion' | escape }}">
      {% if section.settings.banner2_title != blank or section.settings.banner2_desc != blank or section.settings.banner2_subtitle != blank %}
      <div class="promo-copy">
        {% if section.settings.banner2_subtitle != blank %}<p>{{ section.settings.banner2_subtitle }}</p>{% endif %}
        {% if section.settings.banner2_title != blank %}<h3 class="promo-title">{{ section.settings.banner2_title }}</h3>{% endif %}
        {% if section.settings.banner2_desc != blank %}<p>{{ section.settings.banner2_desc }}</p>{% endif %}
      </div>
      {% endif %}
    </a>
    {% endif %}
    {% if section.settings.banner3_img != blank %}
    <a class="promo-slide" data-slider-item href="{% if section.settings.banner3_url != blank %}{{ section.settings.banner3_url }}{% else %}#{% endif %}">
      <img class="promo-slide-img" loading="lazy" src="{{ section.settings.banner3_img | img_url: 'master' }}" alt="{{ section.settings.banner3_title | default: 'Promotion' | escape }}">
      {% if section.settings.banner3_title != blank or section.settings.banner3_desc != blank or section.settings.banner3_subtitle != blank %}
      <div class="promo-copy">
        {% if section.settings.banner3_subtitle != blank %}<p>{{ section.settings.banner3_subtitle }}</p>{% endif %}
        {% if section.settings.banner3_title != blank %}<h3 class="promo-title">{{ section.settings.banner3_title }}</h3>{% endif %}
        {% if section.settings.banner3_desc != blank %}<p>{{ section.settings.banner3_desc }}</p>{% endif %}
      </div>
      {% endif %}
    </a>
    {% endif %}
  </div>
  <div class="promo-nav">
    <button class="promo-arrow prev" type="button" data-slider-prev aria-label="Previous promo">
      <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
    </button>
    <button class="promo-arrow next" type="button" data-slider-next aria-label="Next promo">
      <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
    </button>
  </div>
</section>
