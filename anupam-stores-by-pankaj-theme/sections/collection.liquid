{
"type":"header",
"content":"Shop By Brands Filter Menu"
},
{
  "type": "checkbox",
  "id": "enable_shop_by_brands_filter",
  "label": "Enable Shop By Brands Filter Menu",
  "default": false
},
{
  "type": "text",
