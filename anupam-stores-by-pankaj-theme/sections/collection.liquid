"label": "Linklist"
},
{
"type": "text",
"id": "linkedlist_title",
"label": "Heading"
},
{
"type":"header",
"content":"Collection Filter"
},
{
"type":"checkbox",
"id":"show_filter",
"label":"Enable Filter",
"default":true
},
{
"type": "checkbox",
"id": "collapse_on_larger_devices",
"default": false,
"label": "Collapse On Larger Devices"
},
{
"type":"checkbox",
"id":"enable_sorting",
"label":"Enable Sorting",
"default":true
},
{
"type": "checkbox",
"id": "enable_sidebar_multiple_choice",
"label": "Multiple choices",
"default": true,
"info": "User can select multiple colors (size, brand...) or only one color (size, brand...)?"
},   

    {
"type":"header",
"content":"Best Sellers"
},
  
{
"type": "checkbox",
"id": "show_best_products",
"label": "Enable best sellers",
"default": false
},
{
"type": "text",
"id": "best_title",
"label": "Heading"
},
{
"type": "collection",
"id": "bestseller",
"label": "Collection"
},
{
"type":"header",
"content":"Smart Savings Sidebar Filter Menu"
},
{
  "type": "checkbox",
  "id": "enable_smart_savings_filter",
  "label": "Enable Smart Savings Filter Menu",
  "default": false
},
{
  "type": "text",
  "id": "smart_savings_title",
