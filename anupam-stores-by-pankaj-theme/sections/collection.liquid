  "default": "Shop By Brands"
},
{
  "type": "link_list",
  "id": "shop_by_brands_filter_menu",
  "label": "Select Shop By Brands Menu",
  "info": "Create a menu under Content > Menus containing filters for Shop By Brands filter."
},

{
"type": "text",
"id": "pro_img_width_height",
"default": "80x104",
"label": "Product image width and height (widthxheight)"
},
{
"type": "text",
"id": "limit",
"label": "Product Limit",
"default": "5"
},
{
"type": "checkbox",
"id": "product_rows",
"label": "3 Rows Product"
},

      {
"type":"header",
