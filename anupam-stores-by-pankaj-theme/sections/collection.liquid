<style>
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .collection-listing {
    background: #ffffff !important;
  }
</style>
<section class="collection-listing" aria-labelledby="collection-title" style="background:#ffffff;">
  <div class="container">
    {% render 'collection-template', results: collection, enable_sorting: section.settings.enable_sorting %}
  </div>
</section>

<div class="filter-overlay" data-filter-overlay aria-hidden="true"></div>
<aside class="filter-drawer" id="filter-drawer" data-filter-drawer role="dialog" aria-modal="true" aria-labelledby="filter-title" aria-hidden="true">
  <div class="filter-drawer-head">
    <h2 class="filter-title" id="filter-title">FILTERS</h2>
    <button class="icon-btn filter-close" type="button" data-filter-close aria-label="Close filters">
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
  </div>
  <div class="filter-content">
    {% if current_tags == blank %}
      {% assign has_refined = false %}
    {% else %}
      {% assign has_refined = true %}
    {% endif %}
    {% render 'sidebar-category', enable_sidecategory: section.settings.enable_sidecategory, linkedlist: section.settings.linkedlist, linkedlist_title: section.settings.linkedlist_title %}
    {% render 'facets', results: collection, collapse_on_larger_devices: section.settings.collapse_on_larger_devices, show_filter: section.settings.show_filter, enable_sorting: section.settings.enable_sorting %}
  </div>
  <div class="filter-footer">
    <a class="filter-clear" href="{{ collection.url }}">
      Clear All
      <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
    </a>
  </div>
</aside>
{% schema %}
{
"name": "Collection",
"settings": [
{
"type": "checkbox",
"id": "enable_sidecategory",
"label": "Enable category",
"default": false
},
{
"type": "link_list",
