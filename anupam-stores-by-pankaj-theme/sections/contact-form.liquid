{{ 'anupam-contact.css' | asset_url | stylesheet_tag }}
{%- assign name_attr = 'contact.form.name' | t | handle -%}
{%- assign phone_attr = 'contact.form.phone' | t | handle -%}
{%- assign hero_image = section.settings.hero_image -%}
{%- assign store_one_image = section.settings.store_one_image -%}
{%- assign store_two_image = section.settings.store_two_image -%}

<div class="anupam-contact section-{{ section.id }}" data-contact-section>
  <section class="contact-hero" aria-labelledby="contact-title">
    {% if hero_image %}
    <img class="contact-hero-img" src="{{ hero_image | img_url: '1920x' }}" alt="{{ hero_image.alt | default: section.settings.conact_us | escape }}" width="1920" height="360">
    {% else %}
    <img class="contact-hero-img" src="{{ 'contact-banner.png' | asset_url }}" alt="{{ section.settings.conact_us | escape }}" width="1920" height="360">
    {% endif %}
    <div class="container contact-hero-inner">
      <h1 class="contact-hero-title" id="contact-title">{{ section.settings.conact_us }}</h1>
    </div>
  </section>

  <section class="contact-write" aria-labelledby="write-title">
    <div class="container contact-grid">
      <div class="contact-form-col">
        <h2 class="contact-heading" id="write-title">{{ section.settings.form_title }}</h2>
        {% if section.settings.form_subtitle != blank %}
        <p class="contact-sub">{{ section.settings.form_subtitle }}</p>
        {% endif %}

        {% form 'contact', id: 'ContactForm', class: 'contact-form' %}
          {% if form.posted_successfully? %}
          <p class="note form-success" tabindex="-1" autofocus>{{ 'contact.form.post_success' | t }}</p>
          {% endif %}

          {{ form.errors | default_errors }}

          <div class="contact-row">
            <div class="contact-field">
              <label for="contactFormName">{{ 'contact.form.name' | t }}</label>
              <input id="contactFormName"
                type="text"
                name="contact[{{ name_attr }}]"
                placeholder="{{ 'contact.form.name' | t }}"
                autocapitalize="words"
                autocomplete="name"
                required
                value="{% if form[name_attr] %}{{ form[name_attr] }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>
            <div class="contact-field">
              <label for="contactFormPhone">{{ 'contact.form.phone' | t }}</label>
              <input id="contactFormPhone"
                type="tel"
                name="contact[{{ phone_attr }}]"
                placeholder="{{ 'contact.form.phone' | t }}"
                autocomplete="tel"
                inputmode="tel"
                value="{% if form[phone_attr] %}{{ form[phone_attr] }}{% elsif customer %}{{ customer.phone }}{% endif %}">
            </div>
          </div>

          <div class="contact-field">
            <label for="contactFormEmail">{{ 'contact.form.email' | t }}</label>
            <input id="contactFormEmail"
              type="email"
              name="contact[email]"
              placeholder="{{ 'contact.form.email' | t }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
              aria-required="true"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
          </div>

          <div class="contact-field">
            <label for="contactFormMessage">{{ 'contact.form.message' | t }}</label>
            <textarea id="contactFormMessage" rows="5" name="contact[body]" placeholder="{{ 'contact.form.message' | t }}">{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
          </div>

          <button class="contact-submit" type="submit">
            {{ 'contact.form.send' | t }}
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </button>
        {% endform %}
      </div>

      <aside class="connect-card" aria-labelledby="connect-title">
        <h2 class="connect-title" id="connect-title">{{ section.settings.connect_title }}</h2>
        <ul class="connect-list">
          {% if section.settings.phone != blank %}
          <li class="connect-row">
            <span class="connect-icon material-symbols-outlined" aria-hidden="true">headset_mic</span>
            <div>
              <span class="connect-label">{{ section.settings.phone_label }}</span>
              <a class="connect-value" href="tel:{{ section.settings.phone | strip | replace: ' ', '' }}">{{ section.settings.phone }}</a>
            </div>
          </li>
          {% endif %}
          {% if section.settings.email != blank %}
          <li class="connect-row">
            <span class="connect-icon material-symbols-outlined" aria-hidden="true">mail</span>
            <div>
              <span class="connect-label">{{ section.settings.email_label }}</span>
              <a class="connect-value" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </div>
          </li>
          {% endif %}
        </ul>

        {% if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_pinterest_link != blank or settings.social_youtube_link != blank or settings.social_twitter_link != blank %}
        <h3 class="connect-title connect-title--sub">{{ section.settings.social_title }}</h3>
        <ul class="connect-social">
          {% if settings.social_facebook_link != blank %}
          <li>
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer">
              <span class="connect-icon connect-icon--round" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.5V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg>
              </span>
              Facebook
            </a>
          </li>
          {% endif %}
          {% if settings.social_instagram_link != blank %}
          <li>
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer">
              <span class="connect-icon connect-icon--round" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.7.1 4.8s0 3.6-.1 4.9c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-3.3-.1-4.8-1.7-4.9-4.9-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9C2.3 4 3.9 2.4 7.1 2.3 8.4 2.2 8.8 2.2 12 2.2m0-2.2C8.7 0 8.3 0 7 0 2.7.1.1 2.7 0 7 0 8.3 0 8.7 0 12s0 3.7.1 5c.1 4.3 2.7 6.9 7 7 1.3 0 1.7.1 4.9.1s3.7 0 5-.1c4.3-.1 6.9-2.7 7-7 .1-1.3.1-1.7.1-5s0-3.7-.1-5c-.1-4.3-2.7-6.9-7-7C15.7 0 15.3 0 12 0zm0 5.8A6.2 6.2 0 1 0 18.2 12 6.2 6.2 0 0 0 12 5.8zm0 10.2A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm6.4-10.8a1.4 1.4 0 1 1-1.4-1.4 1.4 1.4 0 0 1 1.4 1.4z"/></svg>
              </span>
              Instagram
            </a>
          </li>
          {% endif %}
          {% if settings.social_pinterest_link != blank %}
          <li>
            <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener noreferrer">
              <span class="connect-icon connect-icon--round" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12c0 5.1 3.2 9.4 7.6 11.2-.1-1-.2-2.4 0-3.4.2-.9 1.4-6 1.4-6s-.4-.7-.4-1.8c0-1.7 1-3 2.2-3 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1 4-.3 1.2.6 2.2 1.8 2.2 2.1 0 3.8-2.2 3.8-5.5 0-2.9-2.1-4.9-5-4.9-3.4 0-5.4 2.5-5.4 5.2 0 1 .4 2.1.9 2.7.1.1.1.2.1.3l-.3 1.3c0 .2-.2.3-.4.2-1.6-.7-2.6-3.1-2.6-5 0-4.1 3-7.8 8.6-7.8 4.5 0 8 3.2 8 7.5 0 4.5-2.8 8.1-6.7 8.1-1.3 0-2.5-.7-3-1.5l-.8 3.1c-.3 1.1-1.1 2.5-1.6 3.4A12 12 0 0 0 12 24c6.6 0 12-5.4 12-12S18.6 0 12 0z"/></svg>
              </span>
              Pinterest
            </a>
          </li>
          {% endif %}
          {% if settings.social_youtube_link != blank %}
          <li>
            <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer">
              <span class="connect-icon connect-icon--round" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.8 15.5v-7l6.2 3.5-6.2 3.5z"/></svg>
              </span>
              YouTube
            </a>
          </li>
          {% endif %}
          {% if settings.social_twitter_link != blank %}
          <li>
            <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener noreferrer">
              <span class="connect-icon connect-icon--round" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M7.273 2.8 10.8 7.822 15.218 2.8h1.768l-5.4 6.139 5.799 8.254h-4.658l-3.73-5.31-4.671 5.31H2.558l5.654-6.427L2.615 2.8zm6.242 13.125L5.07 4.109h1.405l8.446 11.816z" clip-rule="evenodd"/></svg>
              </span>
              Twitter
            </a>
          </li>
          {% endif %}
        </ul>
        {% endif %}
      </aside>
    </div>
  </section>

  {% if section.settings.flag_text != blank %}
  <section class="contact-flag" aria-label="{{ section.settings.company_name | escape }}">
    <div class="container">
      <div class="contact-flag-title">{{ section.settings.flag_text }}</div>
    </div>
  </section>
  {% endif %}

  {% if section.settings.map_iframe != blank or section.settings.map_iframe_one != blank %}
  <section class="store-locator" aria-labelledby="stores-title">
    <h2 class="sr-only" id="stores-title">{{ section.settings.company_name }}</h2>
    <div class="store-stage">
      <div class="store-map">
        {% if section.settings.map_iframe != blank %}
        <div class="store-map-item is-active" data-store-map="1">{{ section.settings.map_iframe }}</div>
        {% endif %}
        {% if section.settings.map_iframe_one != blank %}
        <div class="store-map-item{% if section.settings.map_iframe == blank %} is-active{% endif %}" data-store-map="2">{{ section.settings.map_iframe_one }}</div>
        {% endif %}
      </div>

      {% if section.settings.map_iframe != blank and section.settings.map_iframe_one != blank %}
      <div class="store-switch" role="group" aria-label="{{ section.settings.company_name | escape }}">
        <button class="store-chip is-active" type="button" data-store="1" aria-pressed="true">{{ section.settings.address_label_one | remove: ':' }}</button>
        <button class="store-chip" type="button" data-store="2" aria-pressed="false">{{ section.settings.address_label_two | remove: ':' }}</button>
      </div>
      {% endif %}

      <div class="store-card">
        <article class="store-card-item is-active" data-store-card="1">
          <h3 class="store-card-title">{{ section.settings.company_name }} {{ section.settings.address_label_one | remove: ':' | remove: 'Store' | strip }}</h3>
          <address class="store-card-address">{{ section.settings.address_one }}</address>
          <img class="store-card-img" src="{% if store_one_image %}{{ store_one_image | img_url: '640x360', crop: 'center' }}{% else %}{{ 'store-1.png' | asset_url }}{% endif %}" alt="{{ section.settings.company_name | escape }}" width="640" height="360" loading="lazy">
        </article>
        <article class="store-card-item{% if section.settings.map_iframe == blank %} is-active{% endif %}" data-store-card="2">
          <h3 class="store-card-title">{{ section.settings.company_name }} {{ section.settings.address_label_two | remove: ':' | remove: 'Store' | strip }}</h3>
          <address class="store-card-address">{{ section.settings.address_two }}</address>
          <img class="store-card-img" src="{% if store_two_image %}{{ store_two_image | img_url: '640x360', crop: 'center' }}{% else %}{{ 'store-2.png' | asset_url }}{% endif %}" alt="{{ section.settings.company_name | escape }}" width="640" height="360" loading="lazy">
        </article>
      </div>
    </div>
  </section>
  {% endif %}
</div>

{% schema %}
{
  "name": "Contact Page Section",
  "settings": [
    {
      "type": "text",
      "id": "conact_us",
      "label": "Title",
      "default": "Contact Us"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Banner Image",
      "info": "Falls back to the bundled contact banner when empty"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Heading",
      "default": "Write To Us"
    },
    {
      "type": "textarea",
      "id": "form_subtitle",
      "label": "Form Subheading",
      "default": "We'd love to hear from you. Our team is here to help. Let your customers get in touch with you by filling out the form below."
    },
    {
      "type": "text",
      "id": "connect_title",
      "label": "Connect Card Title",
      "default": "Connect With Us"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social Title",
      "default": "Follow Us"
    },
    {
      "type": "richtext",
      "id": "flag_text",
      "label": "Highlight Band Text",
      "info": "Wrap words in italics to give them the accent serif styling",
      "default": "<p>We carry the flag of <em>success</em>, around the <em>world</em>.</p>"
    },
    {
      "type": "html",
      "id": "map_iframe",
      "label": "Google Map Store 1 Iframe",
      "info": "Paste the <iframe> code from Google Maps here"
    },
    {
      "type": "html",
      "id": "map_iframe_one",
      "label": "Google Map Store 2 Iframe",
      "info": "Paste the <iframe> code from Google Maps here"
    },
    {
      "type": "text",
      "id": "address_label_one",
      "label": "Address One Label",
      "default": "Store 1:"
    },
    {
      "type": "text",
      "id": "address_label_two",
      "label": "Address Two Label",
      "default": "Store 2:"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Label",
      "default": "Contact Number"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Label",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company Name",
      "default": "Anupam Stores"
    },
    {
      "type": "textarea",
      "id": "address_one",
      "label": "Store 1:",
      "default": "580, Broadway, 1002 - New York NY-U"
    },
    {
      "type": "image_picker",
      "id": "store_one_image",
      "label": "Store 1 Image"
    },
    {
      "type": "textarea",
      "id": "address_two",
      "label": "Store 2:",
      "default": "580, Broadway, 1002 - New York NY-U"
    },
    {
      "type": "image_picker",
      "id": "store_two_image",
      "label": "Store 2 Image"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Fax / Phone",
      "default": "123456789"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@example.com"
    }
  ],
  "presets": [
    {
      "name": "Contact Page Section"
    }
  ]
}
{% endschema %}
