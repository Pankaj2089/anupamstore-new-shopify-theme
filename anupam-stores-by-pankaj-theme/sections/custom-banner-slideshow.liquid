{% if section.blocks.size > 0 %}
<section class="hero" aria-label="Featured collections">
  <div class="hero-slider" data-slider data-autoplay="{% if section.settings.enable_banner_slider_autoplay %}true{% else %}false{% endif %}" data-autoplay-speed="{{ section.settings.banner_slider_autoplay_speed | default: 5000 }}">
    <div class="slider-track hero-track" data-slider-track>
      {% for block in section.blocks %}
      {% if block.settings.image != blank %}
      <article class="hero-slide is-photo" data-slider-item {{ block.shopify_attributes }}>
        {% if block.settings.image_link != blank %}
        <a class="hero-photo-link" href="{{ block.settings.image_link }}">
        {% endif %}
        <img
          class="hero-photo"
          src="{{ block.settings.image | image_url: width: 1920 }}"
          alt="{{ block.settings.title | default: shop.name | escape }}"
          {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
          width="1920"
          height="720">
        {% if block.settings.image_link != blank %}
        </a>
        {% endif %}
        {% if block.settings.title != blank or block.settings.subtitle != blank or block.settings.desc != blank or block.settings.btn_txt != blank %}
        <div class="hero-copy{% if block.settings.text_position == 'center' %} on-dark{% endif %}">
          {% if block.settings.subtitle != blank %}<p class="hero-kicker">{{ block.settings.subtitle }}</p>{% endif %}
          {% if block.settings.title != blank %}<h1 class="hero-title">{{ block.settings.title }}</h1>{% endif %}
          {% if block.settings.desc != blank %}<p class="hero-text">{{ block.settings.desc }}</p>{% endif %}
          {% if block.settings.btn_txt != blank %}
          <div class="hero-actions">
            <a class="btn btn-solid" href="{{ block.settings.btn_link | default: routes.collections_url }}">{{ block.settings.btn_txt }}</a>
          </div>
          {% endif %}
        </div>
        {% endif %}
      </article>
      {% endif %}
      {% endfor %}
    </div>
    <button class="slider-btn hero-btn prev" type="button" data-slider-prev aria-label="Previous slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M12 19L5 12L12 5" stroke="#432C1D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M19 12H5" stroke="#432C1D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="slider-btn hero-btn next" type="button" data-slider-next aria-label="Next slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M12 19L5 12L12 5" stroke="#432C1D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M19 12H5" stroke="#432C1D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</section>
{% endif %}

{% schema %}
{
"name": "Custom Banner Slideshow",
"class": "index-section tt-homeslider custom-banner-slideshow",
  "disabled_on": {
    "groups": ["header","footer"]
},
"settings": [
{
"type":"header",
"content":"Banner Slider Autoplay Settings"
},
{
  "type": "checkbox",
