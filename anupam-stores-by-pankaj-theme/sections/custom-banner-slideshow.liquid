  "default": "0"
},
{
"type": "select",
"id": "slider_animation_type",
"label": "Transition effect",
"options": [
{
"value": "slide",
"label": "Slide"
},
{
"value": "fade",
"label": "Fade"
}
]
},
{
"type": "color",
"id": "slide_button_txt_color",
"label": "Button  Color",
"default": "#ffffff"
},
{
"type": "color",
"id": "slide_button_txt_hover_color",
"label": "Button Hover Color",
"default": "#000000"
}
],
"blocks" : [
{
"type": "image",
"name": "Slide",
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Image"
},
{
"type": "image_picker",
"id": "mobile_image",
"label": "Mobile Image"
},
{
"type": "url",
"id": "image_link",
"label": "Image link"
},
{
"type": "checkbox",
"id": "show_video",
"label": "Show video",
"default":false
},
{
"type": "video_url",
"id": "video_url",
"label": "YouTube link",
"accept": ["youtube", "vimeo"]
},
{
"type": "textarea",
"id": "title",
"label": "Title",
"default": "Minimal Work Portfolio"
},
{
"type": "textarea",
"id": "subtitle",
"label": "Sub Title",
"default": "Minimal Work Portfolio"
},
{
"type": "textarea",
"id": "desc",
"label": "Description",
"default": "New Decoration Furniture Home, Office"
},
{
"type": "textarea",
"id": "price_desc",
"label": "Price Description"
},
{
"type": "textarea",
"id": "price",
"label": "price"
},
{
"type": "text",
"id": "btn_txt",
"label": "button text",
"default": "shop now"
},
{
"type": "url",
"id": "btn_link",
"label": "button link"
},
{
"type": "color",
"id": "title_color",
"label": "Title Color",
"default":"#fff"
},
{
"type": "color",
"id": "subtitle_color",
"label": "Sub Title Color",
"default":"#fff"
},
{
"type": "color",
"id": "desc_color",
"label": "Description Color",
"default":"#fff"
},
{
"type": "color",
"id": "desc_bg_color",
"label": "Description Background Color",
"default":"#fff"
},
{
"type": "color",
"id": "price_desccolor",
"label": "Price Description Color",
"default":"#fff"
},
{
"type": "color",
"id": "price_color",
"label": "Price Color",
"default":"#fff"
},
{
"type": "color",
"id": "btn_bg_color",
"label": "button background Color",
"default":"#EB3039"
},
{
"type": "color",
"id": "btn_txt_color",
"label": "Button text Color",
"default":"#fff"
},
{
"type": "color",
"id": "btn_border_color",
"label": "button hover background Color",
"default":"#fff"
},
{
"type": "color",
"id": "btn_hovertxt_color",
"label": "Button hover text Color",
"default":"#fff"
},
{
"type": "select",
"id": "text_position",
"label": "Text Position",
"options": [
{
"value": "left",
"label": "left"
},
{
"value": "right",
"label": "Right"
},
{
"value": "center",
"label": "Center"
}
]
},
{
"type": "select",
"id": "text_effect",
"label": "Text Effect",
"options": [
{
"value": "left",
"label": "left"
},
{
"value": "right",
"label": "Right"
},
{
"value": "top",
"label": "Top"
},
{
"value": "bottom",
"label": "Bottom"
}
]
}             
]
}
],
"presets": [
{
"name": "Custom Banner Slideshow",
"category": "Image",
"settings": {
"slider_animation_type": "slide"
},
"blocks": [
{
"type": "image"
},
{
"type": "image"
}
