{%- comment -%}
  Same markup as the "Top Featured" block of product-tab-model so the cards,
  hover effects and slider behave exactly like the homepage. The slider is
  wired by anupam-homepage.js via .featured-slider / [data-featured-prev|next].
{%- endcomment -%}
{%- assign collection = section.settings.collection -%}

<section class="section featured" id="featured-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      {% if section.settings.title != blank %}
      <h2 class="section-title">{{ section.settings.title | escape }}</h2>
      {% endif %}
      <div class="section-controls">
        {%- if section.settings.show_view_all and collection != blank and collection.url != blank -%}
        <a class="section-link" href="{{ collection.url }}">{{ 'cart.general.view_all_label' | t }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
        <button class="slider-btn prev" type="button" data-featured-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
          <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
        </button>
        <button class="slider-btn next" type="button" data-featured-next aria-label="{{ 'accessibility.next_slide' | t }}">
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </button>
      </div>
    </div>
    <div class="slider-wrapper featured-slider" data-slider>
      <div class="slider-track featured-track" data-slider-track>
        {%- if collection != blank -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            {% render 'anupam-hp-product-card', product: product, collection: collection, card_style: 'featured' %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
"name": "Featured Collections",
"class": "feature-collection",
  "disabled_on": {
    "groups": ["header","footer"]
},
"settings": [
{
"type": "text",
"id": "title",
"default": "Top Featured",
"label": "Featured Collection"
},
{
"type": "collection",
"id": "collection",
"label": "Collection"
},
{
"type": "range",
"id": "products_to_show",
"min": 2,
"max": 20,
"step": 1,
"default": 12,
"label": "Maximum products to show"
},
{
"type": "checkbox",
"id": "show_view_all",
"default": true,
"label": "Enable 'View all' link"
}
],
"presets": [
{
"name": "Featured Collections"
}
]
}
{% endschema %}
