{% if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_fancy_link != blank %}
{% assign show_social_icons = true %}
{% else %}{% assign show_social_icons = false %}{% endif %}

{% if section.settings.newsletter_enable != blank %}
<style>
  #newsletter.newsletter {
    background: #f7f1eb !important;
    text-align: center !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
    float: none !important;
  }
  #newsletter .newsletter-space {
    display: block !important;
    width: 100% !important;
    height: 84px !important;
    min-height: 84px !important;
    line-height: 84px !important;
    font-size: 84px !important;
    overflow: hidden !important;
    visibility: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    float: none !important;
  }
  @media (max-width: 767px) {
    #newsletter .newsletter-space {
      height: 48px !important;
      min-height: 48px !important;
      line-height: 48px !important;
      font-size: 48px !important;
    }
  }
</style>
<section class="newsletter anupam-html-footer" id="newsletter" aria-label="Newsletter">
  <div class="newsletter-space" aria-hidden="true">&nbsp;</div>
  <div class="container newsletter-inner">
    <h2 class="section-title">{{ section.settings.newsletter_title }}</h2>
    {% if section.settings.newsletter_desc != blank %}<p>{{ section.settings.newsletter_desc }}</p>{% endif %}
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}
        <p class="note form-success">{{ 'general.newsletter_form.confirmation' | t }}</p>
      {% else %}
        <label class="sr-only" for="newsletter-email">{{ 'general.newsletter_form.newsletter_label' | t }}</label>
        <input id="newsletter-email" type="email" name="contact[email]" value="{% if customer %}{{ customer.email }}{% endif %}" placeholder="Enter your email address" required autocomplete="email" aria-label="Email address">
        <button class="btn btn-solid" type="submit" name="commit">{{ 'general.newsletter_form.submit' | t }}</button>
      {% endif %}
      {{ form.errors | default_errors }}
    {% endform %}
  </div>
  <div class="newsletter-space" aria-hidden="true">&nbsp;</div>
</section>
{% endif %}

{% if show_social_icons %}
<aside class="follow-rail" aria-label="Follow us">
  {% if settings.social_youtube_link != blank %}
  <a class="follow-rail-icon" href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.8 15.5v-7l6.2 3.5-6.2 3.5z"/></svg>
  </a>
  {% endif %}
  {% if settings.social_pinterest_link != blank %}
  <a class="follow-rail-icon" href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12c0 5.1 3.2 9.4 7.6 11.2-.1-1-.2-2.4 0-3.4.2-.9 1.4-6 1.4-6s-.4-.7-.4-1.8c0-1.7 1-3 2.2-3 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1 4-.3 1.2.6 2.2 1.8 2.2 2.1 0 3.8-2.2 3.8-5.5 0-2.9-2.1-4.9-5-4.9-3.4 0-5.4 2.5-5.4 5.2 0 1 .4 2.1.9 2.7.1.1.1.2.1.3l-.3 1.3c0 .2-.2.3-.4.2-1.6-.7-2.6-3.1-2.6-5 0-4.1 3-7.8 8.6-7.8 4.5 0 8 3.2 8 7.5 0 4.5-2.8 8.1-6.7 8.1-1.3 0-2.5-.7-3-1.5l-.8 3.1c-.3 1.1-1.1 2.5-1.6 3.4A12 12 0 0 0 12 24c6.6 0 12-5.4 12-12S18.6 0 12 0z"/></svg>
  </a>
  {% endif %}
  {% if settings.social_instagram_link != blank %}
  <a class="follow-rail-icon" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.7.1 4.8s0 3.6-.1 4.9c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-3.3-.1-4.8-1.7-4.9-4.9-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9C2.3 4 3.9 2.4 7.1 2.3 8.4 2.2 8.8 2.2 12 2.2m0-2.2C8.7 0 8.3 0 7 0 2.7.1.1 2.7 0 7 0 8.3 0 8.7 0 12s0 3.7.1 5c.1 4.3 2.7 6.9 7 7 1.3 0 1.7.1 4.9.1s3.7 0 5-.1c4.3-.1 6.9-2.7 7-7 .1-1.3.1-1.7.1-5s0-3.7-.1-5c-.1-4.3-2.7-6.9-7-7C15.7 0 15.3 0 12 0zm0 5.8A6.2 6.2 0 1 0 18.2 12 6.2 6.2 0 0 0 12 5.8zm0 10.2A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm6.4-10.8a1.4 1.4 0 1 1-1.4-1.4 1.4 1.4 0 0 1 1.4 1.4z"/></svg>
  </a>
  {% endif %}
  {% if settings.social_facebook_link != blank %}
  <a class="follow-rail-icon" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.5V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg>
  </a>
  {% endif %}
  <span class="follow-rail-label">Follow us</span>
</aside>
{% endif %}

<footer class="site-footer anupam-html-footer" data-section-id="{{ section.id }}" id="footer">
  <div class="container footer-grid">
    {% if section.settings.contact_enable != blank %}
    <section>
      <h3>{{ section.settings.footer_contact_title | default: 'Contact Information' }}</h3>
      <ul class="footer-contact">
        {% if section.settings.contact_no != blank %}
        <li>
          <span class="footer-icon material-symbols-outlined" aria-hidden="true">call</span>
          <div>
            <span class="footer-label">{{ section.settings.contact_desc | default: 'Call On Order ? Call us 24/7' }}</span>
            <a class="footer-value" href="tel:{{ section.settings.contact_no }}">{{ section.settings.contact_no }}</a>
          </div>
        </li>
        {% endif %}
        {% if section.settings.contact_address != blank %}
        <li>
          <span class="footer-icon material-symbols-outlined" aria-hidden="true">location_on</span>
          <div>
            <span class="footer-label">Store 1</span>
            <address><a href="https://maps.google.com/?q=Anupam stores sodala" target="_blank" rel="noopener noreferrer">{{ section.settings.contact_address }}</a></address>
          </div>
        </li>
        {% endif %}
        {% if section.settings.contact_address_one != blank %}
        <li>
          <span class="footer-icon material-symbols-outlined" aria-hidden="true">location_on</span>
          <div>
            <span class="footer-label">Store 2</span>
            <address><a href="https://maps.google.com/?q=Sukh Vrindavan (Anupam store)" target="_blank" rel="noopener noreferrer">{{ section.settings.contact_address_one }}</a></address>
          </div>
        </li>
        {% endif %}
        {% if section.settings.contact_email != blank %}
        <li>
          <span class="footer-icon material-symbols-outlined" aria-hidden="true">mail</span>
          <div>
            <span class="footer-label">Email Address</span>
            <a class="footer-value" href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
          </div>
        </li>
        {% endif %}
      </ul>
    </section>
    {% endif %}
    {% if section.settings.foot_col_1 %}
    <section>
      {% if section.settings.footer_col_title_1 != blank %}<h3>{{ section.settings.footer_col_title_1 }}</h3>{% endif %}
      {% if linklists[section.settings.col_1_menu].links != blank %}
      <ul class="footer-links">
        {% for link in linklists[section.settings.col_1_menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% endif %}
    {% if section.settings.foot_col_2 %}
    <section>
      {% if section.settings.footer_col_title_2 != blank %}<h3>{{ section.settings.footer_col_title_2 }}</h3>{% endif %}
      {% if linklists[section.settings.col_2_menu].links != blank %}
      <ul class="footer-links">
        {% for link in linklists[section.settings.col_2_menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% endif %}
    {% if section.settings.tags_enable != blank %}
    <section>
      {% if section.settings.footer_col_title_3 != blank %}<h3>{{ section.settings.footer_col_title_3 }}</h3>{% endif %}
      {% if linklists[section.settings.col_3_menu].links != blank %}
      <div class="tag-cloud">
        {% for link in linklists[section.settings.col_3_menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
      {% endif %}
    </section>
    {% endif %}
  </div>
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright"><small>{{ 'layout.footer.copyright' | t }} &copy; {{ 'now' | date: "%Y" }}</small> {{ shop.name | link_to: '/' }}</p>
      {% unless shop.enabled_payment_types == empty %}
      <ul class="payment-icons">
        {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
        {%- endfor -%}
      </ul>
      {% endunless %}
    </div>
  </div>
</footer>
