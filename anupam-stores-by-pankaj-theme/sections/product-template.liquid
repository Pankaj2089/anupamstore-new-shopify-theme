<style>
  .product_tab_wrapper ul.tabs li.active>a,
  .product_tab_wrapper ul.tabs li>a:focus,.product_tab_wrapper ul.tabs li>a:hover {
    color:{{ section.settings.tab_text_hover_color }};
  }
  .product_tab_wrapper ul.tabs li>a{
    color:{{ section.settings.tab_text_color }};
  }
</style>

{% if product.metafields.my_fields.countdown.value %}
<script src="{{ 'countdown.js' | asset_url}}" defer="defer"></script>
{% endif %}
{% if product.metafields.my_fields.threesixty_rotate_images %}
<script src="{{ 'threesixty.min.js' | asset_url}}" defer="defer"></script>
{% endif %}
{% if section.settings.product_image_zoom_enable != blank %}
<script src="{{ 'jquery.zoom.min.js' | asset_url}}" defer="defer"></script>
{% endif %}
<script src="{{ 'imagesLoaded.min.js' | asset_url }} " defer="defer"></script> 
{% assign sold_out = true %}
{% if product.available  %}
{% assign sold_out = false %}
{% endif %}
{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- assign product_image_zoom_size = '870x1131' -%}
{%- assign product_image_scale = '2' -%}
{%- assign enable_image_zoom = section.settings.product_image_zoom_enable -%}
{%- assign compare_at_price = current_variant.compare_at_price -%}
{%- assign price = current_variant.price -%}
<div itemscope itemtype="http://schema.org/Product" class="product-template__container page-width"  id="ProductSection-{{ section.id }}"  data-section-id="{{ section.id }}" data-section-type="product-template" data-enable-history-state="true"  data-zoom-enable="{{ section.settings.product_image_zoom_enable }}" data-ajax-enabled="{{ settings.use_ajax_cart }}">
  {% if section.settings.product_layout != 'design_2' %}
  <div class="container">
    {% endif %}
    <section class="pdp" aria-labelledby="pdp-title">
      <div class="container">
        <nav class="collection-crumb pdp-crumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
          {%- assign pdp_crumb_collection = collection -%}
          {%- if pdp_crumb_collection == blank -%}
            {%- for c in product.collections -%}
              {%- if c.handle != 'frontpage' and c.handle != 'all' -%}
                {%- assign pdp_crumb_collection = c -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if pdp_crumb_collection -%}
          <a href="{{ pdp_crumb_collection.url }}">{{ pdp_crumb_collection.title }}</a>
          {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Products</a>
          {%- endif -%}
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
          <span aria-current="page">{{ product.title }}</span>
        </nav>
    {%- assign featured_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
    <div id="product-sticky" class="product-single demo pdp-layout {% if section.settings.product_layout == 'design_1' or section.settings.product_layout == 'design_3' %}{{ section.settings.thumb_position }}{% endif %} {{ section.settings.product_layout }}">
      {% if section.settings.product_layout == 'design_1' or section.settings.product_layout == 'design_3' %} 
      <div class="row">
        {% endif %}
        {% if section.settings.product_layout == 'design_2' %}
        {% render 'anupam-pdp-gallery', product: product, section: section %}
        {% else %}
