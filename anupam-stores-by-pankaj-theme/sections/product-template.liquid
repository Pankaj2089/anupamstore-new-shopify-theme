<script>window.number_of_thumb = {{ section.settings.number_of_thumb }};
  var result = jQuery('input.quantity1');
  jQuery(result).change(function(){
    var qty = result.val();
    result.val(qty);
  });
  function downQty() {
    var qty = result.val();
    if( !isNaN( qty ) && qty > 1 ) {
      qty--;
      result.val(qty);
      return false;
    }
  }

  function upQty() { 
    var qty = result.val();
    if( !isNaN( qty )) { 
      qty++;
      result.val(qty);
      return false;
    }
  }
</script>
