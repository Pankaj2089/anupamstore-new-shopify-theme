                        {% if product.metafields.my_fields.description %}
                          {% assign lines = product.metafields.my_fields.description.value | newline_to_br | split: '<br />' %}
                          <ul class="custom-bullet-list">
                            {% for line in lines %}
                              {% if line != blank %}
                                <li>{{ line | strip_html | strip }}</li>
                              {% endif %}
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>
                      <hr class="hr">
                      {% assign my_fields = product.metafields.custom %}
                      {% assign key = 'countdown' %}
                      {% if my_fields.countdown != nil %} 
                      {% comment %} <hr class="hr"> {% endcomment %}
                      <div class="flip-countdown simple-countdown"><div class="countdown-container flip-countdown" data-countdown="{{ product.metafields.custom.countdown.value | date: "%Y/%m/%d %H:%M:%S" }}"></div></div>
                      {% endif %}
                      {% if section.settings.product_layout == 'design_1' or section.settings.product_layout == 'design_5' %}             
                      <div class="h2 product-single__price" id="price-{{ section.id }}">
                        {% render 'product-price', product: product, use_variant: true, show_vendor: section.settings.show_vendor %}
                      </div>
                      {% endif %} 
                      {% if section.settings.product_layout == 'design_2' or section.settings.product_layout == 'design_1'%} 
                      <hr class="hr">
                      {% endif %}
