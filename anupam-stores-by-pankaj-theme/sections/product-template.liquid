                        {% endif %}
                        <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
                        <meta itemprop="image" content="{{ product.featured_media.src | img_url: 'grande' }}">
                       {% comment %} {%- if product.collections.size > 0 %}
                            {% if section.settings.product_collection %}
                            <p class="product-collection"><label>{{ 'products.product.product_collection' | t }}</label>
                             <span><a href="{{ collection.url }}" class="collection-title text-center" item-prop="collection">{% for collection in product.collections -%} {{ collection.title }}  {% endfor -%}</a></span>
                            </p>
                            {% endif %}
                           {% endif %} {% endcomment %}

                           {% comment %} {{ product.metafields.custom.test_format }} {% endcomment %}
                            {% if section.settings.product_type_enable %}
                               {%- if product.type.size > 0 %}
                          <p class="product-type"> <label>Product Type:</label> <span>{{ product.type }}</span></p>
                          {% endif %}
                          {% endif %}
                          {%- assign pdp_category = collection -%}
                          {%- if pdp_category == blank or pdp_category.handle == 'frontpage' or pdp_category.handle == 'all' -%}
                            {%- assign pdp_category = nil -%}
                            {%- for c in product.collections -%}
                              {%- if c.handle != 'frontpage' and c.handle != 'all' -%}
                                {%- assign pdp_category = c -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                          {%- if pdp_category -%}
                          <p class="product-collection"><label>Category:</label> <span>{{ pdp_category.title }}</span></p>
                          {%- endif -%}
                        {% if current_variant.sku != "" or current_variant.sku != empty  %}
