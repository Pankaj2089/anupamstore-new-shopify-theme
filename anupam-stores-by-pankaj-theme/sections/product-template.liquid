              </div>
              {% when 'external_video' %}
              {% assign external_video = media | external_video_tag %}
              <div class="pro_img" data-image-id="{{ media.id }}">
                <img loading="lazy" class="product-single__photo" id="productPhotoImg" src="{{ media.preview_image | img_url: '150x195' }}" id="productPhotoImg" alt="{{ media.alt | escape }}" data-image-id="{{ media.id }}">
              </div>
              {% when 'video' %}
              <div class="pro_img" data-image-id="{{ media.id }}">
                <img loading="lazy" class="product-single__photo" id="productPhotoImg" src="{{ media.preview_image | img_url: '150x195' }}" id="productPhotoImg" alt="{{ media.alt | escape }}" data-image-id="{{ media.id }}">
              </div>
              {% when 'model' %}
              <div class="pro_img" data-image-id="{{ media.id }}">
                <img loading="lazy" class="product-single__photo" id="productPhotoImg" src="{{ media.preview_image | img_url: '150x195' }}" id="productPhotoImg" alt="{{ media.alt | escape }}" data-image-id="{{ media.id }}">
              </div>
              {% endcase %}
              {%- endfor -%}
            </div>
            {% endif %}
            {% endif %}
            <button type="button" class="pdp-thumbs-btn" data-thumbs-next aria-label="Next thumbnails">
              <span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span>
            </button>
          </div>
