    {% if section.settings.product_layout == 'design_2' %}
    <div class="container">
      {% endif %}
      <div class="product-single__description rte demo">
        <div class="product_tab_wrapper col-xs-12">
          <ul class="tabs nav nav-tabs">
            <li class="active"><a data-toggle="tab"  href="#tab-1">{{ 'products.product.description' | t }}</a></li>
            {%- for block in section.blocks -%}
            {%- case block.type -%}    
            {%- when 'Custom_Tab' -%}
            {% assign block_id = block.id %}
            <li><a data-toggle="tab"  href="#tab-{{ block_id }}">{{ block.settings.tab_title }}</a></li>  
            {% endcase %}  
            {% endfor %}
          </ul>          
          <div class="tab-container">
            <div id="tab-1"  class="tab-pane fade in active">{% if product.description != blank %} {{ product.description }} {% endif %}</div>
            {%- for block in section.blocks -%}
            {%- case block.type -%} 
            {%- when 'Custom_Tab' -%}
            {% assign block_id = block.id %}
            <div id="tab-{{ block_id }}"  class="tab-pane fade">{{ block.settings.tab_content }}</div>
            {% endcase %}  
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="product-review" href="#tab-2">
        {% if product.metafields.spr.reviews != "" %}
        <div id="shopify-product-reviews" data-id="{{product.id}}">{{ product.metafields.spr.reviews }}</div> 
        {% endif %}
      </div>    
      {% unless section.settings.product_layout == 'design_2' %}
      {% if section.settings.related_products_enable %}     
      {% render 'related-products', product: product %}
      {% endif %}
      {% render 'recently-viewed-product', product: product %}
      {% endunless %}
      {% if section.settings.product_layout == 'design_2' %}
    </div>
    {% endif %}
    {% if section.settings.product_layout != 'design_2' %}
  </div>
  {% endif %}

  <!-- Product Sticky -->

  {% if section.settings.addtocart_sticky_bar %}
  <div data-id="product-{{ product.id }}" class="add-to-cart-sticky">
    <div class="container">
  <div class="cart-close position-absolute rounded-circle"></div>
      <div class="sticky-data">
        <div class="main-img-desc">
          {% assign featured_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
          <div class="main_image_wrap1">
            <img loading="lazy" class="product-img" src="{{ featured_image | img_url: '45x' }}" alt="{{ featured_image.alt | escape }}" id="productPhotoImg1">
          </div>	
          <div class="product-desc">
            <div class="product-single__title text-capitalize">{{ product.title | strip_html | truncate : 20 }}</div>
            <div class="h2 product-single__price" id="price-{{ section.id }}">
              {% render 'product-price', product: product, use_variant: true, show_vendor: section.settings.show_vendor %}
            </div>
          </div>
        </div>
        {% if product.has_only_default_variant != true %}
        <div class="color-size">
          <div class="color">
            {% if settings.display_color_variant %}             
            {% render 'item-swatch' , product: product %}
            {% endif %}
          </div>
          <div class="size">
            {% if settings.display_size_variant %}        
            <ul class="product-size">  
              {% for option in product.options %}
              {% if option == 'Size' %}
              {% assign index = forloop.index0 %}
              {% assign sizelist = '' %}
              {% assign size = '' %}
              {% for variant in product.variants %}
              {% capture size %}
              {{ variant.options[index] }}
              {% endcapture %}
              {% unless sizelist contains size %}  
              {% assign text = size | handleize %}
              {% comment %} {{ size }} {% endcomment %}
              {% comment %} {{ size | split: ' ' | last | handle }} {% endcomment %}
              <li class="size{% if sizelist == '' %} active{% endif %}">
                {% comment %} <label>{{ size | split: ' ' | last | handle }}</label> {% endcomment %}
                <label>{{ size }}</label>
                {% if variant.image != null %}
                <span class="hidden">
                  <img loading="lazy" width="373" height="486" src="{{ variant.image.src | product_img_url: '373x486' }}" alt="{{ text }}"/>
                </span>
                {% endif %}
              </li>
              {% capture tempList %}
              {{ sizelist | append: size | append: ' ' }}
              {% endcapture %}
              {% assign sizelist = tempList %}
              {% endunless %}
              {% endfor %}
              {% endif %}
              {% endfor %}
            </ul>
            {% endif %}  
          </div>
        </div>
        {% endif %}  
        <div class="cart-qty">
          {% if product.available %} 
          <div class="product-qty">        
            <form action="/cart/add" method="post" class="variants clearfix cart-form-{{ product.id }}"> 
              <div class="qty-box-set mt-12">  
                <input type="number" name="quantity" value="1" min="1" data-id="Qty" class="quantity">
                <div class="qnt_wrap">
                  <div class="inc button qtyplus"><i class="mdi mdi-plus"></i></div>
                  <div class="dec button qtyminus"><i class="mdi mdi-minus"></i></div>
                </div>
              </div>
            </form>
          </div>
          {% endif %}
          <div class="grid--uniform product-single__addtocart">
            <product-form class="product-form">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-error" viewBox="0 0 13 13">
                  <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                  <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                  <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                  <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7" />
                </svg>
                <span class="product-form__error-message"></span>
              </div>
              {%- assign product_form_id = 'product-form-' | append: section.id -%}
              {%- assign product_form_class = 'product-form-' | append: product.id -%}
              {%- form 'product', product, id: product_form_id, class: product_form_class, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}            
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <div class="product-form__buttons">
                <button id="AddToCart1"
                        type="submit"
                        name="add"
                        class="btn shake-animation product-form__submit button button--full-width {% if product.selling_plan_groups == empty %}button--secondary{% else %}button--primary{% endif %}"
                        {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                        >
                  <svg class="cart" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-bag"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                  <span>
                    {%- if product.selected_or_first_available_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  <div class="loading-overlay__spinner hidden">
                    <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                  </div>
                </button>                      
              </div>
              {%- endform -%}
            </product-form>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- Modal -->
  <div class="modal fade" id="sizeModal" role="dialog">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">&times;</button>
          <h4 class="modal-title tt-title">{{ section.settings.sizechart_lable }}</h4>
        </div>
        <div class="modal-body">
          {% assign sizeChartPageHandle = 'size-chart' %}
          {% assign sizeChartPage = pages[sizeChartPageHandle] %}
          {% if sizeChartPage %}
            <div class="size-chart-section">
              {{ sizeChartPage.content }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  <div id="notify-content" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">&times;</button>
          <h4 class="modal-title tt-title">Notified by Email When This Product Becomes Available.</h4>
        </div>
        {% form 'contact' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input id="product_notify_input" type="hidden" name="contact[product]" value="{{ shop.url }}{{ product.url }}">
        <div class="input-group newsletter-input">
          <input type="email" value="{% if contact %}{{ customer.email }}{% endif %}" placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}" name="contact[email]" id="Email" class="input-group-field" aria-label="{{ 'general.newsletter_form.newsletter_email' | t }}" autocorrect="off" autocapitalize="off">
          <span class="input-group-btn">
            <button type="submit" class="btn icon-fallback-text" name="commit" id="subscribe" aria-label="Name">
              <span class="subscribe">{{ 'general.newsletter_form.submit' | t }}</span>
            </button>
          </span>
        </div>
        {% endform %}
      </div>
    </div>
  </div>
</div>  
