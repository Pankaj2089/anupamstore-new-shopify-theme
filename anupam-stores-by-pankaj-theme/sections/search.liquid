{% comment %}
The {{ content_for_header }} in theme.liquid will output the following stylesheet just for this page:
- <link rel="stylesheet" href="/global/search.css" type="text/css">
It has a few helpers in there, but this theme writes its own styles so there are no dependencies or conflicts. You can ignore that file.
Return only products or pages in results:
- http://docs.shopify.com/manual/configuration/store-customization/return-only-product-in-storefront-search-results
- Or manually add type=product or type=page to the search URL as a parameter
{% endcomment %}
{% comment %}Check to enforce respond.js{% endcomment %}
{% assign respond_js_secret_key = shop.domain | md5 %}
{% unless search.terms == respond_js_secret_key %}
{% if search.performed %}
{% comment %}Avoid accessing search.results before the opening paginate tag.If you do, the pagination of results will be broken.{% endcomment %}
{% paginate search.results by 20 %}
{% comment %}We don't have any results to show. Feel free to show off featured products or suggested searches here.{% endcomment %}
{% unless products_per_page  %}
{% assign products_per_page = 10 %}
{% endunless %}
{% assign products_per_row = settings.collection_products_per_row %}
{% case products_per_row %}
{% when '2' %}
{% assign grid_item_width = 'medium-up--one-third large-up--one-half' %}
{% when '3' %}
{% assign grid_item_width = 'medium-up--one-third large-up--one-third' %}
{% when '4' %}
{% assign grid_item_width = 'medium-up--one-third large-up--one-quarter' %}
{% when '5' %}
{% assign grid_item_width = 'medium-down--one-half large-up--one-fifth' %}
{% when '6' %}
{% assign grid_item_width = 'medium-down--one-half large-up--one-sixth' %}
{% else %}
{% assign grid_item_width = 'medium-up--one-third large-up--one-quarter' %}
{% endcase %}
<div class="search-products">
  <div class="container">
    {% if search.results_count == 0 %}
    <h1 class="text--left section-header__title">{{ 'general.search.no_results_html' | t: terms: search.terms }}</h1>
    {% render 'search-bar' %}
    {% else %}
    <h1 class="text--left section-header__title">{{ 'general.search.results_for_html' | t: terms: search.terms }}</h1>
    {% render 'search-bar' %}
    <div class="search-result-product collection_template">
      <div class="grid-uniform product-grid col-main">
        <div class="products-grid-view">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% if item.type == 'PPLR_HIDDEN_PRODUCT' %}{% continue %}{% endif %}
              <div class="grid-item product-grid {{ settings.product_hover_btn }} {{ grid_item_width }} {{ item.type }}">
                {% render 'product-card-grid', product: item %}
              </div>
            {% else %}
              {% render 'search-result-grid', item: item %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    {% if paginate.pages > 1 %}
    <div class="text-center pagination-wrap">
      {% render 'pagination-custom', paginate: paginate %}
      <div class="showing">
        <span class="show-txt">Showing</span> <span class="loadcount">{{ products_per_page }}</span> of {{ search.results_count }}
      </div>
    </div>
    {% endif %}
    {% endpaginate %}
  </div>
</div>
{% else %}
{% comment %}
If search.performed is false, someone either accessed the page without
the q parameter, or it was blank.
Be sure to show a search form here, along with anything else you want to showcase.
{% endcomment %}
<div class="container">
  <h1 class="h2 left tt-innerpagetitle">{{ 'general.search.title' | t }}</h1>
  {% render 'search-bar' %}
</div>
{% endif %}
{% else %}
{% render 'respond' %}
{% layout none %}
{% endunless %}