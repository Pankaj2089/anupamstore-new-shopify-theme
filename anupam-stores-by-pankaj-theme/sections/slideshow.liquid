<style>
  .homeslider .slides .slick-arrow{color:{{ section.settings.slide_button_txt_color}};}.homeslider .slides .slick-arrow:hover,.homeslider .slides .slick-arrow:focus{color:{{ section.settings.slide_button_txt_hover_color}};}
</style>
<div class="home-slider hb-animate-element bottom-to-top">
  <div class="homeslider type_{{ section.settings.slider_animation_type }}" id="homeslider--{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="slideshow-section" data-animation-type="{{ section.settings.slider_animation_type }}">
    <ul class="slides">
      {% for block in section.blocks %}
      {% if block.settings.image != blank %}
      <li id="slide--{{ block.id }}" class="slide" data-thumb="slide1-thumb.jpg">

        {% if block.settings.show_video == false %}
        <a class="a-img" href="{% if block.settings.image_link != blank %}{{ block.settings.image_link}}{% else %}#{% endif %}">
          <img src="{{ block.settings.image | img_url: "master" }}" alt="slider-image" />
        </a>
        {% endif %}

        {% if block.settings.show_video == true %}
        <div id="popup_toggle">
          <div class="videoimg">  
            <a class="a-img" href="{% if block.settings.image_link != blank %}{{ block.settings.image_link}}{% else %}#{% endif %}">
              <img height="600" width="1860" src="{{ block.settings.image | img_url: "master" }}" alt="slider-image" />
            </a>
            <div class="slider-content-wrap content-{{ block.settings.text_position }} effect_{{ block.settings.text_effect }}">               
              {% if block.settings.desc != blank %}<div class="slider-desc" style="color:{{ block.settings.desc_color }};background:{{ block.settings.desc_bg_color }};">{{ block.settings.desc }}</div>{% endif %}                        
              {% if block.settings.subtitle != blank %}<div class="slider-subtitle" style="color:{{ block.settings.subtitle_color }}">{{ block.settings.subtitle }}</div>{% endif %}              
              {% if block.settings.title != blank %}<div class="slider-title" style="color:{{ block.settings.title_color }}">{{ block.settings.title }}</div>{% endif %}              
              {% if block.settings.price_desc != blank %}<div class="slider-pricedesc" style="color:{{ block.settings.price_desccolor }}">{{ block.settings.price_desc }} <span class="price" style="color:{{ block.settings.price_color }}">{{ block.settings.price }}</span></div>{% endif %}     
              {% if block.settings.btn_txt != blank %}
              <div class="slider-button">
                <a href="{{ block.settings.btn_link }}" class="btn">{{ block.settings.btn_txt}}</a>      
              </div>
              {% endif %}
            </div>
            <span class="play-icone"><i class="mdi mdi-play-circle" aria-hidden="true"></i></span>       
          </div>
        </div>
        <div class="popup_overlay">
          <div class="popup" id="popupVid"><a class="popup_close">X</a>
            {% if block.settings.video_url.id == blank %}
            <iframe src="//www.youtube.com/embed/_9VUPq3SxOc?autoplay=1&showinfo=0&rel=0&enablejsapi=1?vq=720" width="1860" height="600" frameborder="0" allowfullscreen></iframe>
            {% else %}
            {% if block.settings.video_url.type == "youtube" %}
            <iframe src="//www.youtube.com/embed/{{ block.settings.video_url.id }}?vq=720&rel=0&loop=1&autoplay=1&background=1&enablejsapi=1&muted=1&player_id=bgvid-0" width="1860" height="600" allow='autoplay' frameborder="0" allowfullscreen></iframe>
            {% elsif block.settings.video_url.type == "vimeo" %}
            <iframe src="//player.vimeo.com/video/{{ block.settings.video_url.id }}?byline=0&portrait=0&badge=0&loop=1&autoplay=1&enablejsapi=1&background=1&muted=1&player_id=bgvid-0" width="1860" height="600" frameborder="0" allowfullscreen></iframe>
            {% endif %}
            {% endif %}
          </div>
        </div>
        {% endif %}

        {% if block.settings.show_video == false %}
        <div class="slider-content-wrap content-{{ block.settings.text_position }} effect_{{ block.settings.text_effect }}">         
          {% if block.settings.desc != blank %}<div class="slider-desc" style="color:{{ block.settings.desc_color }};background:{{ block.settings.desc_bg_color }};">{{ block.settings.desc }}</div>{% endif %}                    
          {% if block.settings.subtitle != blank %}<div class="slider-subtitle" style="color:{{ block.settings.subtitle_color }}">{{ block.settings.subtitle }}</div>{% endif %}              
          {% if block.settings.title != blank %}<div class="slider-title" style="color:{{ block.settings.title_color }}">{{ block.settings.title }}</div>{% endif %}          
          {% if block.settings.price_desc != blank %}<div class="slider-pricedesc" style="color:{{ block.settings.price_desccolor }}">{{ block.settings.price_desc }} <span class="price" style="color:{{ block.settings.price_color }}">{{ block.settings.price }}</span></div>{% endif %}          
          {% if block.settings.btn_txt != blank %}
          <div class="slider-button">
            <a href="{{ block.settings.btn_link }}" class="btn">{{ block.settings.btn_txt}}</a>
          </div>
          {% endif %}
        </div>
        {% endif %}
        <style> .tt-homeslider .home-slider .homeslider #slide--{{ block.id }} .slider-content-wrap .slider-desc::after, .tt-homeslider .home-slider .homeslider #slide--{{ block.id }} .slider-content-wrap .slider-desc::before{
          background:{{ block.settings.desc_bg_color }};
        }
          #slide--{{ block.id }} .slider-button a{background-color:{{block.settings.btn_bg_color}};color:{{block.settings.btn_txt_color}}}#slide--{{ block.id }} .slider-button{border-color:{{ block.settings.btn_bg_color }};}#slide--{{ block.id }} .slider-button:hover,#slide--{{ block.id }} .slider-button:focus,#slide--{{ block.id }} .slider-button:active{border-color:{{ block.settings.btn_border_color }};} #slide--{{ block.id }} .slider-button a::after{background-color:{{ block.settings.btn_border_color }};}#slide--{{ block.id }} .slider-button a:hover,#slide--{{ block.id }} .slider-button a:focus,#slide--{{ block.id }} .slider-button a:active{color:{{ block.settings.btn_hovertxt_color }}}
        </style>
      </li>
      {% else %}
      <li id="slide--{{ block.id }}" {{ block.shopify_attributes }}>
        <span class="slide-link">
          {% capture current %}{% cycle 1, 2 %}{% endcapture %}
          {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
        </span>
      </li>
      {% endif %}  
      {% endfor %}
    </ul>
  </div>
</div>
{% schema %}
{
"name": "Slideshow",
"class": "index-section tt-homeslider",
  "disabled_on": {
    "groups": ["header","footer"]
},
"settings": [
{
"type": "select",
"id": "slider_animation_type",
"label": "Transition effect",
"options": [
{
"value": "slide",
"label": "Slide"
},
{
"value": "fade",
"label": "Fade"
}
]
},
{
"type": "color",
"id": "slide_button_txt_color",
"label": "Button  Color",
"default": "#ffffff"
},
{
"type": "color",
"id": "slide_button_txt_hover_color",
"label": "Button Hover Color",
"default": "#000000"
}
],
"blocks" : [
{
"type": "image",
"name": "Slide",
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Image"
},
{
"type": "image_picker",
"id": "mobile_image",
"label": "Mobile Image"
},
{
"type": "url",
"id": "image_link",
"label": "Image link"
},
{
"type": "checkbox",
"id": "show_video",
"label": "Show video",
"default":false
},
{
"type": "video_url",
"id": "video_url",
"label": "YouTube link",
"accept": ["youtube", "vimeo"]
},
{
"type": "textarea",
"id": "title",
"label": "Title",
"default": "Minimal Work Portfolio"
},
{
"type": "textarea",
"id": "subtitle",
"label": "Sub Title",
"default": "Minimal Work Portfolio"
},
{
"type": "textarea",
"id": "desc",
"label": "Description",
"default": "New Decoration Furniture Home, Office"
},
{
"type": "textarea",
"id": "price_desc",
"label": "Price Description"
},
{
"type": "textarea",
"id": "price",
"label": "price"
},
{
"type": "text",
"id": "btn_txt",
"label": "button text",
"default": "shop now"
},
{
"type": "url",
"id": "btn_link",
"label": "button link"
},
{
"type": "color",
"id": "title_color",
"label": "Title Color",
"default":"#fff"
},
{
"type": "color",
"id": "subtitle_color",
"label": "Sub Title Color",
"default":"#fff"
},
{
"type": "color",
"id": "desc_color",
"label": "Description Color",
"default":"#fff"
},
{
"type": "color",
"id": "desc_bg_color",
"label": "Description Background Color",
"default":"#fff"
},
{
"type": "color",
"id": "price_desccolor",
"label": "Price Description Color",
"default":"#fff"
},
{
"type": "color",
"id": "price_color",
"label": "Price Color",
"default":"#fff"
},
{
"type": "color",
"id": "btn_bg_color",
"label": "button background Color",
"default":"#EB3039"
},
{
"type": "color",
"id": "btn_txt_color",
"label": "Button text Color",
"default":"#fff"
},
{
"type": "color",
"id": "btn_border_color",
"label": "button hover background Color",
"default":"#fff"
},
{
"type": "color",
"id": "btn_hovertxt_color",
"label": "Button hover text Color",
"default":"#fff"
},
{
"type": "select",
"id": "text_position",
"label": "Text Position",
"options": [
{
"value": "left",
"label": "left"
},
{
"value": "right",
"label": "Right"
},
{
"value": "center",
"label": "Center"
}
]
},
{
"type": "select",
"id": "text_effect",
"label": "Text Effect",
"options": [
{
"value": "left",
"label": "left"
},
{
"value": "right",
"label": "Right"
},
{
"value": "top",
"label": "Top"
},
{
"value": "bottom",
"label": "Bottom"
}
]
}             
]
}
],
"presets": [
{
"name": "Slideshow",
"category": "Image",
"settings": {
"slider_animation_type": "slide"
},
"blocks": [
{
"type": "image"
},
{
"type": "image"
}
]
}
]
}
{% endschema %}